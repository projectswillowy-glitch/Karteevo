# User Storefront (Next.js) Environment Variables for Vercel

# Backend API base URL (must end with /api)
NEXT_PUBLIC_API_URL=https://karteevo.vercel.app/api
# Backend origin (used by next.config image allowlist)
NEXT_PUBLIC_BACKEND_URL=https://karteevo.vercel.app
# Public storefront origin (Better-Auth callback origin)
NEXT_PUBLIC_WEB_URL=https://www.karteevo.com
