ADMIN_SUPPORT_NAME=Karteevo Support
ADMIN_SUPPORT_EMAIL=support@karteevo.com
ADMIN_SUPPORT_PHONE=+1234567890
ADMIN_SUPPORT_ADDRESS=123 Main St, New York, NY

# Admin seed credentials (used by create-admin script)
